     [[nodiscard]] virtual TupleDelimiterOffsets getTupleDelimiterOffsets() const = 0;
     [[nodiscard]] virtual size_t getNumberOfTuples() const = 0;
+
+    /// Whether an index built over an ASSEMBLED spanning tuple actually holds a readable record.
+    /// The framework's spanning-tuple assembly is size-based; for formats where any bytes between two
+    /// delimiters form a record (CSV, JSON) that suffices, hence the default. Formats with structural
+    /// records (XML: content must contain a complete <root>...</root>) override this so the framework
+    /// skips reading a record from an assembly that indexed to nothing instead of dereferencing an
+    /// empty index.
+    [[nodiscard]] virtual bool hasSpanningRecord() const { return true; }
 };
 
 }
