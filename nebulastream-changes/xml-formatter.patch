+# name: formatter/BasicTypeSupportXML.test
+# description: tests XML formatter with all basic data types
+# groups: [Formatter, XML]
+
+GlobalConfiguration worker.default_query_execution.operator_buffer_size: [4096]
+
+CREATE LOGICAL SOURCE multiBufferXML(field_1 BOOLEAN, field_2 INT8, field_4 INT16, field_5 INT32, field_6 INT64, field_7 UINT8, field_8 UINT16, field_9 UINT32, field_10 UINT64, field_11 FLOAT32, field_12 FLOAT64);
+CREATE PHYSICAL SOURCE FOR multiBufferXML TYPE File SET("XML" AS PARSER.`TYPE`);
+ATTACH INLINE
+<agencia><field_1>true</field_1><field_2>-128</field_2><field_4>-32768</field_4><field_5>-2147483648</field_5><field_6>-9223372036854775808</field_6><field_7>255</field_7><field_8>65535</field_8><field_9>4294967295</field_9><field_10>18446744073709551615</field_10><field_11>-340282346638528859811704183484516925440.0</field_11><field_12>-.0</field_12></agencia>
+<agencia><field_1>false</field_1><field_2>127</field_2><field_4>32767</field_4><field_5>2147483647</field_5><field_6>9223372036854775807</field_6><field_7>0</field_7><field_8>0</field_8><field_9>0</field_9><field_10>0</field_10><field_11>340282346638528859811704183484516925440.0</field_11><field_12>.0</field_12></agencia>
+
+CREATE SINK sinkMultiBufferXML(multiBufferXML.field_1 BOOLEAN, multiBufferXML.field_2 INT8, multiBufferXML.field_4 INT16, multiBufferXML.field_5 INT32, multiBufferXML.field_6 INT64, multiBufferXML.field_7 UINT8, multiBufferXML.field_8 UINT16, multiBufferXML.field_9 UINT32, multiBufferXML.field_10 UINT64, multiBufferXML.field_11 FLOAT32, multiBufferXML.field_12 FLOAT64) TYPE Checksum;
+
+SELECT * FROM multiBufferXML INTO sinkMultiBufferXML;
+----
+2, 300
diff --git a/nes-systests/formatter/XML/BasicXML.test b/nes-systests/formatter/XML/BasicXML.test
new file mode 100644
index 0000000000..e0036665c0
--- /dev/null
+++ b/nes-systests/formatter/XML/BasicXML.test
@@ -0,0 +1,25 @@
+# name: XML_Benchmark.test
+# description: benchmarks the XML input formatter
+# groups: [Formatter, XML, Benchmark]
+
+# Define the logical schema
+CREATE LOGICAL SOURCE xmlStream(KEY UINT64, VALUE UINT64, NAME VARSIZED);
+
+# Configure the physical source to use the XML parser
+CREATE PHYSICAL SOURCE FOR xmlStream TYPE File SET("XML" AS PARSER.`TYPE`);
+
+# Attach inline data using the default <agencia> tags
+ATTACH INLINE
+<agencia><KEY>1</KEY><VALUE>10</VALUE><NAME>user_a</NAME></agencia>
+<agencia><KEY>2</KEY><VALUE>20</VALUE><NAME>user_b</NAME></agencia>
+<agencia><KEY>3</KEY><VALUE>30</VALUE><NAME>user_c</NAME></agencia>
+<agencia><KEY>4</KEY><VALUE>40</VALUE><NAME>user_d</NAME></agencia>
+<agencia><KEY>5</KEY><VALUE>50</VALUE><NAME>user_e</NAME></agencia>
+
+# Create a checksum sink to verify correctness
+CREATE SINK allFieldsSink(xmlStream.KEY UINT64, xmlStream.VALUE UINT64, xmlStream.NAME VARSIZED) TYPE Checksum;
+
+# Execute query to trigger the indexer
+SELECT * FROM xmlStream INTO allFieldsSink;
+----
+5, 150
diff --git a/nes-systests/formatter/XML/ErrorHandlingXML.test b/nes-systests/formatter/XML/ErrorHandlingXML.test
