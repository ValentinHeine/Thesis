# name: benchmark/Bimbo_XML.test
# description: end-to-end throughput benchmark for the XML input formatter (XMLInputFormatIndexer) using the Bimbo schema.
# Data file: nes-systests/testdata/large/xml/Bimbo_500MB.xml (~500 MB, 1.37M tuples), generated by tiling
# nes-input-formatters/tests/UnitTests/testdata/XML/Bimbo.xml with field tags uppercased.
# Field/tag names are UPPERCASE: the SQL parser uppercases unquoted identifiers
# (nes-sql-parser CommonParserFunctions.cpp), and the XML indexer matches tag names exactly.
# To run: built with -DENABLE_LARGE_TESTS=ON, then invoke the systest_large_benchmark_* CMake target,
# or `systest -b -t .../Bimbo_XML.test`.
# groups: [benchmark, large, Formatter, XML]

# Source definition. Field names must match the XML element names exactly (the indexer does an exact key lookup).
CREATE LOGICAL SOURCE bimbo(
    AGENCIA_ID INT16,
    CANAL_ID INT16,
    CLIENTE_ID INT32,
    DEMANDA_UNI_EQUIL INT16,
    DEV_PROXIMA FLOAT64,
    DEV_UNI_PROXIMA INT32,
    NUMBER_OF_RECORDS INT16,
    PRODUCTO_ID INT32,
    RUTA_SAK INT16,
    SEMANA INT16,
    VENTA_HOY FLOAT64,
    VENTA_UNI_HOY INT16);
CREATE PHYSICAL SOURCE FOR bimbo TYPE File SET("XML" AS INPUT_FORMATTER.`TYPE`);
ATTACH FILE large/xml/Bimbo_500MB.xml

CREATE SINK bimboAllSink(
    bimbo.AGENCIA_ID INT16,
    bimbo.CANAL_ID INT16,
    bimbo.CLIENTE_ID INT32,
    bimbo.DEMANDA_UNI_EQUIL INT16,
    bimbo.DEV_PROXIMA FLOAT64,
    bimbo.DEV_UNI_PROXIMA INT32,
    bimbo.NUMBER_OF_RECORDS INT16,
    bimbo.PRODUCTO_ID INT32,
    bimbo.RUTA_SAK INT16,
    bimbo.SEMANA INT16,
    bimbo.VENTA_HOY FLOAT64,
    bimbo.VENTA_UNI_HOY INT16) TYPE Checksum;
CREATE SINK bimboProjSink(price FLOAT64) TYPE Checksum;
CREATE SINK bimboFilterSink(
    bimbo.AGENCIA_ID INT16,
    bimbo.PRODUCTO_ID INT32,
    bimbo.VENTA_HOY FLOAT64) TYPE Checksum;

# Q0: full-scan throughput — pure formatter cost dominates.
SELECT * FROM bimbo INTO bimboAllSink;
----
1373000 2895024047

# Q1: projection with arithmetic — formatter + simple compute.
SELECT VENTA_HOY * FLOAT64(89) / FLOAT64(100) AS price FROM bimbo INTO bimboProjSink;
----
1373000 499382068

# Q2: selective filter — formatter + predicate evaluation. Modulo predicate chosen so the result set is non-empty.
SELECT AGENCIA_ID, PRODUCTO_ID, VENTA_HOY FROM bimbo WHERE PRODUCTO_ID % INT32(2) = INT32(0) INTO bimboFilterSink;
----
612358 475898276
